# Tài khoản (docs/ACCOUNTS_PLAN.md). Chép file này thành .env.local rồi điền giá trị.
# .env.local KHÔNG được commit (đã có trong .gitignore).

# Supabase → Project Settings → API (hoặc Connect): Project URL và Publishable key (anon key cũng được).
# Hai giá trị này được đưa vào trang web — an toàn vì bảng progress có row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chỉ dùng cho lệnh `pnpm users:*` trên máy bạn — TUYỆT ĐỐI không đưa lên web hay git.
# Supabase → Project Settings → API Keys → Secret key (hoặc service_role key).
SUPABASE_SECRET_KEY=

# Tuỳ chọn: tên miền ẩn để đổi tên tài khoản thành e-mail cho Supabase (không bao giờ gửi mail).
# NEXT_PUBLIC_ACCOUNT_EMAIL_DOMAIN=learn-app.local
